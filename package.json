{
  "name": "juki",
  "version": "1.0.0",
  "description": "this a nocode tool to help build nextjs apps(proof of concept)",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "",
    "build": "",
    "dev:engine": "cd .juki/engine && go tool air",
    "dev:editor": "cd .juki/editor && pnpm dev --port 8889",
    "dev": "concurrently \"pnpm  dev:engine\" \"pnpm  dev:editor\"",
    "gen:protos": "./scripts/gen-protos.sh",
    "postinstall": "cd .juki/editor && pnpm install"
  },
  "keywords": [
    "react",
    "nextjs",
    "nocode",
    "golang"
  ],
  "author": "Paa-Kofi Aidoo",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}